{
  "name": "kojax-adventure",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "prestart": "npm run build",
    "start": "python3 -m http.server 4173 --bind 127.0.0.1 --directory dist",
    "test": "node --test tests/*.test.js",
    "check:release": "node scripts/check-release.mjs",
    "format": "prettier --write src scripts tests",
    "format:check": "prettier --check src scripts tests"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "prettier": "3.9.9"
  },
  "engines": {
    "node": ">=22"
  }
}
